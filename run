#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCS_TOOL="$ROOT_DIR/scripts/agent-continuity-docs"

print_help() {
  cat <<'EOF'
GlobalOverlayKit commands

  ./run build    compile the Swift package
  ./run test     run the Swift tests
  ./run docs     refresh and validate Agent Continuity docs
  ./run check    run the complete local verification baseline

Start here: ./run check
EOF
}

case "${1:-help}" in
  help|-h|--help)
    print_help
    ;;
  build)
    cd "$ROOT_DIR"
    swift build
    ;;
  test)
    cd "$ROOT_DIR"
    swift test
    ;;
  docs)
    cd "$ROOT_DIR"
    "$DOCS_TOOL" update
    "$DOCS_TOOL" check
    "$DOCS_TOOL" check-links
    tests/agent-continuity-docs-smoke.sh
    ;;
  check)
    cd "$ROOT_DIR"
    swift build
    swift test
    "$DOCS_TOOL" update
    "$DOCS_TOOL" check
    "$DOCS_TOOL" check-links
    tests/agent-continuity-docs-smoke.sh
    git diff --check
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo >&2
    print_help >&2
    exit 2
    ;;
esac

