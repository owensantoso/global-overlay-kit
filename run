#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCS_TOOL="$ROOT_DIR/scripts/agent-continuity-docs"
DEMO_PACKAGE_DIR="$ROOT_DIR/Examples/DesktopPhysicsDemo"
DEMO_APP_DIR="$DEMO_PACKAGE_DIR/App"
DEMO_DERIVED_DATA="$DEMO_APP_DIR/DerivedData"
DEMO_APP="$DEMO_DERIVED_DATA/Build/Products/Debug/Desktop Physics Demo.app"
DESKTOP_GAME_CORE_DIR="$ROOT_DIR/../DesktopGameCore"

desktop_game_core_is_available() {
  [[ -f "$DESKTOP_GAME_CORE_DIR/Package.swift" ]]
}

print_private_example_skip() {
  echo "SKIP DesktopPhysicsDemo: private sibling DesktopGameCore is absent at $DESKTOP_GAME_CORE_DIR"
  echo "Public clones can run the core GlobalOverlayKit checks without private credentials."
}

require_desktop_game_core() {
  if desktop_game_core_is_available; then
    return
  fi
  print_private_example_skip >&2
  echo "Pair this checkout with the private DesktopGameCore repository before using demo commands." >&2
  exit 1
}

build_demo_app() {
  require_desktop_game_core
  (
    cd "$DEMO_APP_DIR"
    xcodegen generate --spec project.yml
    xcodebuild \
      -project DesktopPhysicsDemo.xcodeproj \
      -scheme DesktopPhysicsDemo \
      -configuration Debug \
      -destination 'platform=macOS,arch=arm64' \
      -derivedDataPath "$DEMO_DERIVED_DATA" \
      build
  )
}

check_desktop_physics_demo() {
  if ! desktop_game_core_is_available; then
    print_private_example_skip
    return
  fi
  swift test --package-path "$DEMO_PACKAGE_DIR"
  build_demo_app
  npm --prefix "$DEMO_PACKAGE_DIR/PhoneWorld" run verify
}

print_help() {
  cat <<'EOF'
GlobalOverlayKit commands

  ./run build    compile the Swift package
  ./run test     run the Swift tests
  ./run demo     build and launch the desktop physics example
  ./run demo-trace  launch the demo with bounded trajectory logs
  ./run desktop-physics-check  verify the optional paired-workspace example
  ./run phone-world-check  verify the phone page, relay, and browser controls
  ./run docs     refresh and validate Agent Continuity docs
  ./run check    run the complete local verification baseline

Start here: ./run check
EOF
}

case "${1:-help}" in
  help|-h|--help)
    print_help
    ;;
  build)
    cd "$ROOT_DIR"
    swift build
    ;;
  test)
    cd "$ROOT_DIR"
    swift test
    ;;
  demo)
    build_demo_app
    open -n "$DEMO_APP"
    ;;
  demo-trace)
    build_demo_app
    DESKTOP_PHYSICS_TRACE=1 open -n "$DEMO_APP"
    ;;
  desktop-physics-check)
    check_desktop_physics_demo
    ;;
  phone-world-check)
    npm --prefix "$DEMO_PACKAGE_DIR/PhoneWorld" run verify
    ;;
  docs)
    cd "$ROOT_DIR"
    "$DOCS_TOOL" update
    "$DOCS_TOOL" check
    "$DOCS_TOOL" check-links
    tests/agent-continuity-docs-smoke.sh
    ;;
  check)
    cd "$ROOT_DIR"
    swift build
    swift test
    check_desktop_physics_demo
    "$DOCS_TOOL" check
    "$DOCS_TOOL" check-links
    tests/agent-continuity-docs-smoke.sh
    git diff --check
    ;;
  *)
    echo "Unknown command: $1" >&2
    echo >&2
    print_help >&2
    exit 2
    ;;
esac
